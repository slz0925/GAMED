# Regenerable Python/build/environment files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
.venv/
venv/
.idea/
.vscode/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Local routing and credentials; examples remain trackable
/config/local.json
/config/*.local.json
.env
.env.*
!.env.example
*.pem
*.key

# Data and pretrained model assets stay outside the code repository
/dataset/
/ernie/
*.pth
*.pt
*.pkl
*.bin
*.safetensors
*.ckpt
*.zip
*.npz
*.pickle
*.csv
*.tsv
*.xlsx

# Generated evaluation and training files, including root-level exports
train_*__val_*/
*.out
*.log
/npresult*.txt
/data/*record*.txt
/data/*scores.txt
/runs/
/output_dir/
/outputs/**
!/outputs/.gitkeep
/checkpoint/**
!/checkpoint/README.md

# Non-versioned resources and local verification files
/resources/local/
*integrity.local.json
